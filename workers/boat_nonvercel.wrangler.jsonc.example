{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "race-ai-boat-private-pilot",
  "main": "workers/boat_nonvercel_cron.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "triggers": { "crons": [] },
  "d1_databases": [
    { "binding": "BOAT_DB", "database_name": "race-ai-boat-private-pilot",
      "database_id": "REPLACE_WITH_APPROVED_NEW_D1_ID" }
  ],
  "vars": {
    "BOAT_AUTO_ENABLED": "false",
    "BOAT_RIGHTS_REVIEWED": "false",
    "BOAT_RIGHTS_REFERENCE": "APPROVAL_REQUIRED",
    "BOAT_PILOT_VENUE": "17",
    "BOAT_MAX_REQUESTS_PER_DAY": "60"
  }
}
