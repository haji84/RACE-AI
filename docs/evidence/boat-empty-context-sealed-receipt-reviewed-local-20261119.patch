+            with self.subTest(level=level, kind=kind):
+                cli.prepare_runtime(round_no=round_no)
+                self.output.write_text("")
+                if level == "cycle":
+                    parent.mkdir(mode=0o700, exist_ok=True)
+                path = parent if level == "parent" else parent/f"cycle-{round_no}"
+                if kind == "file":
+                    path.write_bytes(b"not-an-input-directory"); path.chmod(0o600)
+                else:
+                    os.mkfifo(path, mode=0o600)
+                try:
+                    code, text = self.run_cli(["generate", "--round", str(round_no)])
+                    self.assertEqual(code, 2, text)
+                    report = json.loads(text)
+                    self.assertEqual(report["reason"], "ALL_MODEL_CLI_RETAINED_INPUT_PATH_INVALID")
+                    self.assertNotIn("contexts", report)
+                    self.assertNotIn("generated_forecasts", report)
+                    self.assertEqual(self.output.read_text(), "ready=false\n")
+                    self.assertFalse((self.temp/f"boat-all-model-forecasts/cycle-{round_no}/forecasts.enc").exists())
+                finally:
+                    path.unlink()
