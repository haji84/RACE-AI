+    def test_empty_directory_is_zero_but_zero_byte_or_malformed_input_is_hold(self):
+        cli.prepare_runtime(round_no=1)
+        folder = self.temp/"boat-all-model-inputs/cycle-1"
+        folder.mkdir(parents=True, mode=0o700)
+        code, text = self.run_cli(["generate", "--round", "1"])
+        self.assertEqual(code, 0, text)
+        self.assertTrue(json.loads(text)["ready"])
+        cipher_path = self.temp/"boat-all-model-forecasts/cycle-1/forecasts.enc"
+        original = cipher_path.read_bytes()
+        source = folder/"20300401-01-01.json"
+        for raw in (b"", b"not-json", b"{}", wire({"schema": engine.INPUT_SCHEMA}).encode()):
+            with self.subTest(raw=raw):
+                source.write_bytes(raw); source.chmod(0o600)
+                code, text = self.run_cli(["generate", "--round", "1"])
+                self.assertEqual(code, 2, text)
+                self.assertEqual(json.loads(text)["status"], "ALL_MODEL_PATH_REJECTED")
+                self.assertNotIn("generated_forecasts", json.loads(text))
+                self.assertEqual(cipher_path.read_bytes(), original)
+        source.unlink()
+        target = self.temp/"private-empty.json"; target.write_bytes(b"{}"); target.chmod(0o600)
+        source.symlink_to(target)
+        code, text = self.run_cli(["generate", "--round", "1"])
+        self.assertEqual(code, 2, text)
+        self.assertEqual(cipher_path.read_bytes(), original)
