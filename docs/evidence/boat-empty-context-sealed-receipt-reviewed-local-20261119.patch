+    def test_zero_contexts_still_require_valid_issued_inventory_owner_and_runtime(self):
+        marker = cli.prepare_runtime(round_no=1)
+        code, text = self.run_cli(["generate", "--round", "2"])
+        self.assertEqual(code, 2, text)
+        self.assertEqual(json.loads(text)["reason"], "ALL_MODEL_CLI_PREPARED_ROUND_MISMATCH")
+        with patch.dict(os.environ, RACE_AI_STATE_KEY=base64.b64encode(b"f"*32).decode()):
+            code, text = self.run_cli(["generate", "--round", "1"])
+        self.assertEqual(code, 2, text)
+        issued = Path(marker["issued_models_path"])
+        issued.write_text(wire({"fictional-race": ["not-a-registered-model"]}))
+        marker["issued_models_sha256"] = hashlib.sha256(issued.read_bytes()).hexdigest()
+        ready = self.temp/"boat-all-model-runtime/runtime-ready.json"
+        ready.write_text(wire(marker))
+        code, text = self.run_cli(["generate", "--round", "1"])
+        self.assertEqual(code, 2, text)
+        self.assertFalse((self.temp/"boat-all-model-forecasts/cycle-1/forecasts.enc").exists())
+        cli.prepare_runtime(round_no=2)
+        with patch.dict(os.environ, GITHUB_SHA="b"*40):
+            code, text = self.run_cli(["generate", "--round", "2"])
+        self.assertEqual(code, 2, text)
+        Path(cli.restore_ready()["runtime_files"]["history.sqlite"]).write_bytes(b"invalid-runtime")
+        code, text = self.run_cli(["generate", "--round", "2"])
+        self.assertEqual(code, 2, text)
+        self.assertFalse((self.temp/"boat-all-model-forecasts/cycle-2/forecasts.enc").exists())
