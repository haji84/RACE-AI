+    def test_empty_directory_or_parent_symlink_never_becomes_a_zero_receipt(self):
+        parent = self.temp/"boat-all-model-inputs"
+        target = self.temp/"private-empty-inputs"; target.mkdir(mode=0o700)
+        for round_no, kind in enumerate(("cycle", "dangling-cycle", "parent", "dangling-parent"), 1):
+            with self.subTest(kind=kind):
+                cli.prepare_runtime(round_no=round_no)
+                destination = target if not kind.startswith("dangling") else self.temp/"absent-inputs"
+                if kind.endswith("cycle"):
+                    parent.mkdir(mode=0o700, exist_ok=True)
+                    link = parent/f"cycle-{round_no}"
+                else:
+                    if parent.exists(): parent.rmdir()
+                    link = parent
+                link.symlink_to(destination, target_is_directory=True)
+                try:
+                    code, text = self.run_cli(["generate", "--round", str(round_no)])
+                    self.assertEqual(code, 2, text)
+                    self.assertEqual(json.loads(text)["reason"], "ALL_MODEL_CLI_RETAINED_INPUT_PATH_INVALID")
+                    self.assertFalse((self.temp/f"boat-all-model-forecasts/cycle-{round_no}/forecasts.enc").exists())
+                finally:
+                    link.unlink()
