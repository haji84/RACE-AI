+    def test_empty_receipt_save_failure_is_hold_and_partial_cipher_cannot_be_regenerated(self):
+        for round_no, failure in ((1, "cipher"), (2, "manifest")):
+            with self.subTest(failure=failure):
+                cli.prepare_runtime(round_no=round_no)
+                self.output.write_text("")
+                save = cli.save
+                def fail(path, body, **options):
+                    if (failure == "cipher" and Path(path).name == "forecasts.enc" or
+                            failure == "manifest" and Path(path).name == f"cycle-{round_no}.json"):
+                        raise OSError("private-failure-detail-must-not-leave")
+                    return save(path, body, **options)
+                with patch.object(cli, "save", side_effect=fail):
+                    code, text = self.run_cli(["generate", "--round", str(round_no)])
+                self.assertEqual(code, 2, text)
+                self.assertEqual(json.loads(text)["status"], "ALL_MODEL_PATH_REJECTED")
+                self.assertNotIn("private-failure-detail", text)
+                self.assertEqual(self.output.read_text(), "ready=false\n")
+                path = self.temp/f"boat-all-model-forecasts/cycle-{round_no}/forecasts.enc"
+                if failure == "manifest":
+                    original = path.read_bytes()
+                    code, text = self.run_cli(["generate", "--round", str(round_no)])
+                    self.assertEqual(code, 2, text)
+                    self.assertEqual(path.read_bytes(), original)
+                else:
+                    self.assertFalse(path.exists())
+                self.assertFalse((self.temp/"boat-all-model-readback.json").exists())
+
