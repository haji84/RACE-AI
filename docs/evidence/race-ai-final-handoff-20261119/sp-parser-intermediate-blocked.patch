+            else: data['SJ0315']['sensyuTypeInfo'][0]['ketujyouTuikaHojyu'] = '欠場' if mode == 'withdrawn' else '架空未知状態'
+            result = self.parse(data=data)
+            self.assertTrue(bool(result['no_published_roster_exclusion_observed'] is False
