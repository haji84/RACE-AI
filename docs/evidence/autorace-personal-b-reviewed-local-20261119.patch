+    def test_post_trial_initial_scope_requires_eight_confirmed_slots_and_registered_ids(self):
+        for kind in ('seven','duplicate_car','duplicate_id','history_id_mismatch','unknown_id','withdrawn','unknown_withdrawal'):
+            data = post_trial_fixture(); players = data['program']['body']['playerList']
+            if kind=='seven':
+                players.pop()
+                for length in (3,10):data['program']['body'][f'latest{length}List'].pop('1008')
+            elif kind=='duplicate_car':players[1]['carNo']=players[0]['carNo']
+            elif kind=='duplicate_id':players[1]['playerCode']=players[0]['playerCode']
+            elif kind=='history_id_mismatch':players[0]['playerCode']=9999
+            elif kind=='unknown_id':players[0]['playerCode']=None
+            elif kind=='withdrawn':players[0]['retireFlag']=1
+            else:players[0]['retireFlag']=None
+            reseal_source(data, 'program'); converted = self.build(data)
+            with self.subTest(kind=kind):
+                self.assertEqual(converted['phase_states']['A_PRE_TRIAL']['state'], 'HOLD')
+                self.assertEqual(converted['phase_states']['B_POST_TRIAL']['state'], 'HOLD')
+                self.assertNotIn('autorace/'+PERSONAL, {r['cell_key'] for r in converted['requests']})
