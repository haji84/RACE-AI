+    def test_post_trial_original_scorer_registry_capsules_and_exact_six_cell_case_agree(self):
+        from race_ai.autorace_personal_baseline import predict_personal
+        from race_ai.all_existing_model_inputs import _additional_source_pairs
+        from race_ai.all_existing_model_pairs import _native_input
+        from scripts.all_existing_model_source_packet_freeze import case_inputs
+        data = post_trial_fixture(); converted = self.build(data)
+        self.assertEqual(len(converted['requests']), 6)
+        known = {cell['cell_key']:cell for cell in registry.cells()}
+        expected_refs = set(map(tuple, converted['source_refs'])); stages = []
+        for request in converted['requests']:
+            payload = request['native_payload']; mid = request['cell_key'].split('/',1)[1]
+            self.assertEqual(_additional_source_pairs(payload, as_of=NOW.isoformat()), expected_refs)
+            capsule, info, sport = _native_input(request['cell_key'], payload, known, now=NOW,
+                allow_source=lambda ref,right,purpose:purpose=='analysis' and (ref,right) in expected_refs)
+            self.assertEqual(sport, 'autorace'); stages.append(info['stage'])
+            self.assertEqual(info['roster'], {str(n):str(1000+n) for n in range(1,9)})
+            if mid == PERSONAL:
+                original = predict_personal(payload['snapshot'], generated_at=NOW.isoformat())
+                replay = registry.predict(mid, sport, payload, at=NOW, allow_source=lambda *_:True)
+                self.assertEqual(replay['candidate_count'], 336)
+                self.assertEqual(replay['ordered_top8'], original['ordered_top8'])
+                self.assertEqual(replay['supplemental_four'], original['supplemental_four'])
+                self.assertEqual(replay['model_version'], '0.1.0-HEURISTIC-UNTRAINED')
+                self.assertEqual((len(replay['ordered_top8']), len(replay['supplemental_four'])), (8,4))
+        self.assertEqual((stages.count('B_POST_TRIAL'), stages.count('P0')), (1,5))
+        b64 = lambda raw:base64.b64encode(raw).decode('ascii')
